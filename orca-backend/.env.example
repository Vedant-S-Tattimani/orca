# ORCA Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Application settings
DEBUG=True
HOST=0.0.0.0
PORT=8000
# CORS Allowed Origins
# Development default (Localhost)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Production placeholder (Uncomment and replace for production)
# ALLOWED_ORIGINS=https://your-production-domain.com,https://app.your-production-domain.com

# Database settings
MONGODB_URL=mongodb+srv://your_db_user:your_password@your-cluster.mongodb.net/?appName=orca

# API Keys for external services (get these from respective agencies)
INCOIS_API_KEY=your_incois_api_key_here
IMD_API_KEY=your_imd_api_key_here
ISRO_BHUVAN_API_KEY=your_isro_bhuvan_api_key_here

# Auth settings
SECRET_KEY=your_super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Vector store settings
VECTOR_STORE_TYPE=faiss  # Options: faiss, pgvector
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM settings
LLM_PROVIDER=groq  # Options: openai, anthropic, local, groq
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=groq/compound-mini  # For groq
# For openai: gpt-3.5-turbo
# For anthropic: claude-3-sonnet-20240229
# For local: llama2 (if using ollama or similar)

# Risk thresholds file path
THRESHOLDS_FILE=app/rules/thresholds.yaml
